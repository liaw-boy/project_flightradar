# NOTE: backend/data/raw_jonty.json is intentionally NOT ignored (committed
# to git) — it feeds merge_routes.js and has no known automated download
# source, unlike the other files in this block. The Electron/macOS release
# CI (backend/scripts/prebuild-electron-data.mjs) needs it checked out.

# Training data (large binary/CSV datasets, not for git)
training_data/
backend/data/routes.db-shm
backend/data/routes.db-wal

# Generated/downloaded data — rebuilt by scripts/download_data.js,
# process_data.js, build-routes-db.js (see backend/scripts/)
backend/data/routes.db
backend/data/raw_openflights.dat
backend/data/aircraft.csv.gz
backend/data/processed/

# Python (ml_trajectory) — venv and bytecode caches never tracked
backend/ml_trajectory/.venv/
backend/ml_trajectory/**/__pycache__/
*.pyc

# ml_trajectory artifacts (model.pt, scalers, history backups, retrain log) —
# the nightly retrain cron (server.js) writes these directly to the live
# checkout without ever committing. Tracking them in git means the next
# `deploy.sh` git pull would hit "local changes would be overwritten by
# merge" on these binary files and abort, or silently discard a freshly-
# promoted model. Never track these; each environment has its own.
backend/ml_trajectory/artifacts/
