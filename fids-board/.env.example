TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
PORT=3800

# [2026-09] The account this service used got suspended (quota exhausted)
# 3 days into the month. TDX's basic/free member tier is 3 points/month
# combined across ALL TDX data services (not just FIDS), roughly 3,000
# calls — per public docs found via search, not confirmed directly on TDX's
# own pricing page (verify on the account's 會員中心/訂閱方案 page). A
# full poll cycle here is 8 airports x 2 directions = 16 calls (see
# jobs/poller.js / services/airports.js).
#
# 0 */6 * * * (every 6h, 4 cycles/day) = 64 calls/day = ~1,984/month over a
# 31-day month — about 66% of the ~3,000/month budget, leaving headroom for
# token refreshes and the rest of the account's usage. Do not go below this
# interval without first confirming the real quota on TDX's dashboard.
POLL_CRON=0 */6 * * *

ODPT_CONSUMER_KEY=
