TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
PORT=3800

# [2026-09] The account this service used got suspended (quota exhausted)
# 3 days into the month. TDX's basic/free member tier (confirmed 2026-10-01
# from the account's own plan page: TWD 0/month, 3 virtual points/month,
# 5 requests/min per key) is 3 points/month combined across ALL TDX data
# services (not just FIDS). A point is not a flat 1,000 calls: the account's
# usage dashboard showed 11,165 calls = 8.123 points (~1,370 calls/point), so
# the real monthly ceiling is roughly 3,000-4,100 calls depending on how
# points are weighted (call count and/or data volume) — plan against the low
# end. A full poll cycle here is 8 airports x 2 directions = 16 calls (see
# jobs/poller.js / services/airports.js), spaced 13s apart to stay under the
# 5/min limit.
#
# 0 */6 * * * (every 6h, 4 cycles/day) = 64 calls/day = ~1,984/month over a
# 31-day month — about 66% of the low-end ~3,000/month budget, leaving
# headroom for token refreshes and the rest of the account's usage. Do not
# go below this interval without first checking the real quota on TDX's
# dashboard.
POLL_CRON=0 */6 * * *

ODPT_CONSUMER_KEY=
