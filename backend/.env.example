# 監控頁面密碼（/monitor 路徑，session-based）
MONITOR_PASSWORD=

# OpenSky 帳號池（選填，最多 5 組；額度用盡時自動輪替）
OPENSKY_USER1=
OPENSKY_PASS1=
OPENSKY_USER2=
OPENSKY_PASS2=
OPENSKY_USER3=
OPENSKY_PASS3=
OPENSKY_USER4=
OPENSKY_PASS4=
OPENSKY_USER5=
OPENSKY_PASS5=

# API Keys（選填，增加資料來源覆蓋率）
AERODATABOX_API_KEY=
AIRLABS_API_KEY=

# TDX（選填，台灣本地航班補充資料）
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# CORS（逗號分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005

PORT=3000
LOG_LEVEL=INFO
NODE_ENV=production

# Public site URL, used for OAuth callback construction
APP_URL=http://localhost:3000

# Google OAuth（登入用）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session/JWT signing secret — generate a long random string, never reuse across envs
JWT_SECRET=

# SQLite path override — set this for any scratch/verification instance so it
# doesn't write to the same file as the live systemd service (see docs/deploy.md).
# Leave unset in production; defaults to backend/data/aerostrat.db.
AEROSTRAT_DB_PATH=

# Set to "true" on any non-primary instance (e.g. staging) sharing the same
# upstream API keys as production, so it doesn't also poll OpenSky/adsb.lol/
# adsb.fi/TDX or run nightly cron jobs — avoids doubling external request
# volume / racing on shared files like ml_trajectory/artifacts/model.pt.
# Leave unset (or "false") in production.
DISABLE_BACKGROUND_JOBS=

# Discord webhook for the nightly trajectory-predictor retrain result
# (promoted/rejected/failed). Optional — unset just skips notification.
DISCORD_RETRAIN_WEBHOOK_URL=

# Discord webhook for real-time emergency-squawk alerts (7500/7600/7700).
# Optional — falls back to DISCORD_RETRAIN_WEBHOOK_URL if unset, so it works
# with just one webhook configured; set this separately to split channels.
DISCORD_EMERGENCY_WEBHOOK_URL=

# Discord webhook for total-outage alerts (all 3 upstream sources down) and
# recovery. Optional — falls back to DISCORD_RETRAIN_WEBHOOK_URL if unset.
DISCORD_OUTAGE_WEBHOOK_URL=

# Discord webhook for military-aircraft alerts, scoped to Taiwan + nearby
# airspace (see MILITARY_ALERT_BBOX in broadcastEngine.js). Optional —
# falls back to DISCORD_RETRAIN_WEBHOOK_URL if unset.
DISCORD_MILITARY_WEBHOOK_URL=

# Discord webhook for special-livery aircraft alerts (data/specialLiveries.json).
# Optional — falls back to DISCORD_RETRAIN_WEBHOOK_URL if unset.
DISCORD_LIVERY_WEBHOOK_URL=
