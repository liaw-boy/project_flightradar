# 監控頁面密碼（/monitor 路徑，session-based）
MONITOR_PASSWORD=

# OpenSky 帳號池（選填，最多 5 組；額度用盡時自動輪替）
OPENSKY_USER1=
OPENSKY_PASS1=
OPENSKY_USER2=
OPENSKY_PASS2=
OPENSKY_USER3=
OPENSKY_PASS3=
OPENSKY_USER4=
OPENSKY_PASS4=
OPENSKY_USER5=
OPENSKY_PASS5=

# API Keys（選填，增加資料來源覆蓋率）
AERODATABOX_API_KEY=
AIRLABS_API_KEY=

# TDX（選填，台灣本地航班補充資料）
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# CORS（逗號分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005

PORT=3000
LOG_LEVEL=INFO
NODE_ENV=production
