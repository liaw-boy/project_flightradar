{
  "name": "project_flightradar",
  "version": "5.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"node server.js\" \"cd client && npm run dev\"",
    "seed-shapes": "node scripts/seedAircraftShapes.js",
    "sync-mictronics": "node scripts/syncMictronics.js",
    "test": "jest --forceExit --testTimeout=15000 --runInBand",
    "test:watch": "jest --watch --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "test:unit": "jest --forceExit --testTimeout=15000 --runInBand --testPathIgnorePatterns=\"__tests__/(api|stress|user-journey)\\.test\\.js\"",
    "test:smoke": "jest --forceExit --testTimeout=15000 --runInBand --testPathPattern=\"(api|stress|user-journey)\\.test\\.js\""
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testTimeout": 15000
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.8.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "msgpack-lite": "^0.1.26",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
